# PostgreSQL 16 Configuration
POSTGRES_USER=affiliate
POSTGRES_PASSWORD=affiliate_secret
POSTGRES_DB=threads_affiliate
POSTGRES_PORT=5432

# Backend API Configuration
BACKEND_PORT=8000
DATABASE_URL=postgresql+asyncpg://affiliate:affiliate_secret@localhost:5432/threads_affiliate
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TZ=Asia/Jakarta

# Frontend Web Dashboard Configuration
# On a VPS, replace localhost with your VPS IP or domain (e.g., http://123.45.67.89:8000)
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
