# =============================================================================
# InstaBox Telegram AI Vision Agent Configuration
# =============================================================================

# 1. Telegram Bot Token (buat di @BotFather -> /newbot)
TELEGRAM_BOT_TOKEN=

# 2. Chat ID Telegram kamu (opsional saat tes pertama: kirim /id ke bot, lalu isi di sini agar hanya kamu yang bisa mengontrol InstaBox!)
TELEGRAM_ALLOWED_CHAT_ID=

# 3. Vision AI Provider (OpenAI-compatible: Google Gemini, 9Router, OpenRouter, dll.)
# Contoh Google Gemini (direkomendasikan — cepat & murah untuk vision):
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_API_KEY=
AI_MODEL=gemini-2.5-flash

# Contoh jika pakai OpenRouter:
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=google/gemini-2.5-flash

# 4. Batas langkah maksimal per prompt (anti-loop & hemat token)
MAX_AGENT_STEPS=25

# 5. X11 Display (biarkan kosong untuk auto-detect layar Chromium InstaBox)
DISPLAY=
